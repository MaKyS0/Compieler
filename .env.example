# Copy to .env (never commit it). Used by docker-compose.yml.
COMPIELER_SECRET_KEY=change-me-to-a-long-random-string      # e.g. `openssl rand -base64 48`
POSTGRES_PASSWORD=change-me-too
COMPIELER_HTTP_PORT=8080
COMPIELER_MAX_CONCURRENT_RUNS=8
COMPIELER_ALLOW_RUNTIME_NETWORK=false
COMPIELER_ALLOW_REGISTRATION=true
# Heavy packages baked into the sandbox image so projects don't each download them (optional):
# RUNNER_PRELOAD_PACKAGES="numpy pandas matplotlib scipy pillow"
